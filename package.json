{
  "name": "agentq",
  "version": "0.1.0",
  "description": "Local task queues for parallel Codex and Claude Code agents",
  "type": "module",
  "bin": {
    "agentq": "dist/agentq"
  },
  "files": [
    "dist/agentq*",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/cli.tsx",
    "build": "bun scripts/build.ts",
    "check:package": "bun scripts/check-package.ts",
    "test": "bun scripts/test.ts",
    "test:coverage": "bun test --coverage --max-concurrency=4",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:package",
    "prepack": "bun run check"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "codex",
    "claude-code",
    "task-queue",
    "agents",
    "cli",
    "tui",
    "bun",
    "ink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luke-Pitstick/agentq.git"
  },
  "bugs": {
    "url": "https://github.com/Luke-Pitstick/agentq/issues"
  },
  "homepage": "https://github.com/Luke-Pitstick/agentq#readme",
  "author": "Luke Pitstick",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.216",
    "@openai/codex": "^0.145.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
