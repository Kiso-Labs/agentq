{
  "name": "agentq",
  "version": "0.1.0",
  "description": "Local task queues for parallel Codex and Claude Code agents",
  "type": "module",
  "bin": {
    "agentq": "dist/agentq"
  },
  "files": [
    "dist/agentq*",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.tsx",
    "build": "node --import tsx scripts/build.ts",
    "check:package": "node --import tsx scripts/check-package.ts",
    "test": "vitest run --fileParallelism=false --maxWorkers=4",
    "test:coverage": "vitest run --coverage --fileParallelism=false --maxWorkers=4",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:package",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "codex",
    "claude-code",
    "task-queue",
    "agents",
    "cli",
    "tui",
    "nodejs",
    "ink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiso-Labs/agentq.git"
  },
  "bugs": {
    "url": "https://github.com/Kiso-Labs/agentq/issues"
  },
  "homepage": "https://github.com/Kiso-Labs/agentq#readme",
  "author": "Luke Pitstick",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.216",
    "@openai/codex": "^0.145.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.25.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
